# Interface to bind to
interface={lan_interface}

# Bind dynamic interfaces as they come up
bind-dynamic

# DHCP IP Range & lease time
dhcp-range={dhcp_start},{dhcp_end},12h

# DHCP Options (Option 3 = Gateway, Option 6 = DNS)
dhcp-option=3,{gateway_ip}
dhcp-option=6,{gateway_ip}

# Upstream public DNS forwarders for authenticated clients
server=1.1.1.1
server=8.8.8.8

# Authoritative local portal hostnames
address=/portal.pisowifi/{gateway_ip}
address=/wifi.login/{gateway_ip}
