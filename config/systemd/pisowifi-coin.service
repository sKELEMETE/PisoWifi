[Unit]
Description=PisoWiFi Coin Listener
After=network.target pisowifi-backend.service

[Service]
User=root
WorkingDirectory=/opt/pisowifi/backend
Environment="PATH=/opt/pisowifi/backend/venv/bin"
ExecStart=/opt/pisowifi/backend/venv/bin/python run_coin_listener.py
Restart=always
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/pisowifi
ProtectHome=true

[Install]
WantedBy=multi-user.target
