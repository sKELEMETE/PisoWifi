# ==============================================================================
# PisoWiFi Vending Appliance - Production Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Permissions should be set to 0600 (chmod 0600 .env)
# ==============================================================================

# Application Environment (production, development, testing)
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
PISOWIFI_DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=pisowifi
DATABASE_USER=pisowifi
DATABASE_PASSWORD=CHANGE_ME_STRONG_RANDOM_DB_PASSWORD

# For standalone or embedded SQLite mode:
# PISOWIFI_DATABASE_TYPE=sqlite
# PISOWIFI_DATABASE_URL=sqlite:////opt/pisowifi/pisowifi.db

# ------------------------------------------------------------------------------
# Security & Administrative Credentials
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
# Bcrypt hash for admin password. Generate using:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH='$2b$12$6Dtpd4zlU39na/Nip4AmVu6cy1po5FxmxG8ZAQj7ulMXnnYX1H5l2'

# Cryptographically secure random HMAC key (minimum 32 bytes / 256 bits).
# Generate using: openssl rand -hex 32
ADMIN_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_TOKEN_EXPIRE_HOURS=2

# ------------------------------------------------------------------------------
# Network, Gateway & Ports
# ------------------------------------------------------------------------------
PISOWIFI_GATEWAY_IP=10.0.0.1
PISOWIFI_SUBNET_CIDR=10.0.0.0/24
PISOWIFI_LAN_INTERFACE_FALLBACK=wlan0
WAN_INTERFACE=eth0
CAPTIVE_PORTAL_PORT=80
PISOWIFI_BACKEND_PORT=8000
PISOWIFI_ADMIN_PORT=8443

# Allowed CORS Origins (comma separated)
PISOWIFI_CORS_ORIGINS=http://10.0.0.1,http://localhost,http://localhost:5173,http://127.0.0.1

# ------------------------------------------------------------------------------
# Firewall & Bandwidth Shaping
# ------------------------------------------------------------------------------
PISOWIFI_FIREWALL_DRIVER=nftables
NFT_TABLE_NAME=pisowifi
NFT_SET_NAME=authenticated_clients

PISOWIFI_BANDWIDTH_DRIVER=linux_tc
PISOWIFI_BANDWIDTH_RATE=10mbit
PISOWIFI_BANDWIDTH_CEIL=10mbit

# ------------------------------------------------------------------------------
# Coin Hardware Acceptor Configuration
# ------------------------------------------------------------------------------
# Interface mode: arduino or gpio
COIN_INTERFACE=arduino
SERIAL_PORT=AUTO
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
SERIAL_RECONNECT_INTERVAL=5
SERIAL_DEBOUNCE_MS=250

COIN_SESSION_LEASE_SECONDS=12
COIN_HEARTBEAT_SECONDS=3
COIN_LEASE_CHECK_INTERVAL=1
COIN_CURRENCY_SYMBOL=₱

# For Direct GPIO Mode:
# GPIO_COIN_CHIP=/dev/gpiochip1
# GPIO_COIN_LINE=10
# GPIO_RELAY_CHIP=/dev/gpiochip1
# GPIO_RELAY_LINE=11
# GPIO_RELAY_ACTIVE_LOW=true

# ------------------------------------------------------------------------------
# Paths & System Dirs
# ------------------------------------------------------------------------------
PISOWIFI_BASE_DIR=/opt/pisowifi
PISOWIFI_RUN_DIR=/opt/pisowifi/run
BACKUP_DIRECTORY=/opt/pisowifi/backups
LOG_DIRECTORY=/opt/pisowifi/logs
SFX_DIRECTORY=/opt/pisowifi/sfx

# ------------------------------------------------------------------------------
# Scheduling & Backups
# ------------------------------------------------------------------------------
SESSION_CHECK_INTERVAL=30
PAUSE_EXPIRATION_DAYS=30
SCHEDULER_INTERVAL=5
BACKUP_TIME=03:00
